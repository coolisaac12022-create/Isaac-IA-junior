server-candidat-noyau-essai.tmp.js
backups-noyau/
backups-noyau-essai/
backups/
# Sauvegardes de l instance d essai — artifacts de lecture, jamais publiés
backups-essai/

# ---------- VOIX NEURONALE (voice manager, 2026-10-02) ----------
# Le binaire Piper et les modeles .onnx pesent ~250 Mo : ce sont des artefacts telecharges,
# pas du code. VOIX-NEURONALE.bat les repose sur n'importe quelle machine d'Isaac.
tts/piper/
tts/voix/
# Le cache de synthese : des WAV nommes par leur empreinte, regenerables a volonte.
tts/cache/
# Journal des decisions de voix — local, il nomme ce qu'Isaac a fait dire a ses agentes.
journal-voix.log
journal-voix.essai.log

# ---------- AI GATEWAY (Phase 4, 2026-10-04) ----------
# Journal des cerveaux : quel fournisseur a ete tente, lequel a repondu, en combien
# de temps, et pourquoi les autres se sont tus. Local, comme ses freres : il trace
# l'activite du PC d'Isaac, il ne se publie pas. (Aucune cle n'y est ecrite.)
journal-ai.log
journal-ai.essai.log

# Capture d'ecran de diagnostic : elle montre l'ecran d'Isaac, jamais publiee.
capture-ecran.png

# Sortie console de l'instance d'essai : elle recopie des dictées et des mesures locales.
essai-*.out
