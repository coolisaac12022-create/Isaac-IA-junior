taches.json
taches.essai.json

# Carnet de prospection BUSINESS : listes d'entreprises, contacts, messages, contrats —
# c'est le fichier commercial d'Isaac, jamais publié (le code, lui, est dans server.js).
business/

# Le code que l'eququipe s'ecrit a elle-meme : geste appris = dictee personnelle d'Isaac.
# Jamais publie sans son ordre (il peut le demander : c'est du code, pas des donnees).
# Le geste appris est du CODE : ordre d'Isaac du 2026-10-01, extensions.js est publie.
# (La ligne d'ignorance a ete retiree ici — le fichier monte sur GitHub.)
!journal-evolution.log
extensions.essai.js
journal-evolution.essai.log
# Atelier du coeur : noyau de l instance d essai, fichier de test, sauvegardes du noyau — locaux
server.essai.js
